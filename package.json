{
  "name": "spc-plank-viewer",
  "version": "1.0.0",
  "description": "Framework-agnostic, physically scaled SPC flooring viewer with procedural PBR materials.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/spc-plank-viewer.es.js",
  "module": "./dist/spc-plank-viewer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spc-plank-viewer.es.js"
    },
    "./products.json": "./src/data/products.json",
    "./schema.json": "./src/data/product.schema.json"
  },
  "files": [
    "dist",
    "src/data",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:website": "vite --host 127.0.0.1 --open /website/",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json && vite build --mode demo",
    "preview": "vite preview --outDir demo-dist --host 127.0.0.1",
    "build:room": "npm run typecheck && vite build --mode room",
    "preview:room": "vite preview --outDir room-dist --host 127.0.0.1",
    "test:room": "node tests/room-browser.mjs",
    "build:website": "npm run typecheck && vite build --mode website",
    "preview:website": "vite preview --outDir website-dist --host 127.0.0.1",
    "build:site": "npm run typecheck && node scripts/build-site.mjs",
    "preview:site": "vite preview --outDir site-dist --host 127.0.0.1",
    "test:website": "node tests/website-browser.mjs",
    "test:story": "node tests/story-browser.mjs",
    "test:visualizer": "node tests/visualizer-browser.mjs",
    "build:v2": "npm run typecheck && vite build --mode v2",
    "preview:v2": "vite preview --outDir v2-dist --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "precompute:rooms": "tsx scripts/precompute-rooms.mts"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "onnxruntime-web": "^1.31.1",
    "qrcode-generator": "^1.4.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
